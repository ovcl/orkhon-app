# Orkhon Valley App — орчны хувьсагч
# Хуулж .env.local болгоно (Vercel дээр Project Settings → Environment Variables)

# Production домэйн — SEO, sitemap, Open Graph зураг (заавал тохируулна)
NEXT_PUBLIC_SITE_URL=https://orkhon.example.mn

# AI хөтөч (сонголттой). Хоосон эсвэл "sk-"-ээр эхлээгүй бол AI хэсэг автоматаар нуугдана.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Нэг IP-ээс минутад хэдэн асуулт, бүх хэрэглэгчийн өдрийн дээд хязгаар
AI_RATE_LIMIT_PER_MIN=8
AI_DAILY_LIMIT=500

# Киоск горим (?kiosk=1): идэвхгүй хэдэн секундын дараа нүүр хуудас руу буцах
NEXT_PUBLIC_KIOSK_IDLE_SECONDS=180
